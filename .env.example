# Live Translate Environment Configuration
# Copy this file to .env and configure your settings

# LibreTranslate routing
# When true, an embedded LibreTranslate process is started inside the live-translate container.
LIBRETRANSLATE_LOCAL_ENABLED=true
# Internal URL used when local mode is enabled (server path is ignored in local mode).
LIBRETRANSLATE_LOCAL_URL=http://127.0.0.1:5001
# External/server URL used only when LIBRETRANSLATE_LOCAL_ENABLED=false.
LIBRETRANSLATE_SERVER_URL=http://libretranslate:5000

# Logging
LOG_DIR=/data/logs

# Session icon upload directory (default is container-local and not host-mapped)
# To persist icons to host storage, set SESSION_ICON_DIR=/app/session-icons
# and enable the optional volume mapping in docker-compose.yml.
SESSION_ICON_DIR=/tmp/session-icons

# Whisper Speech-to-Text Configuration
WHISPER_ENABLED=true
WHISPER_MODEL=tiny # Options: tiny, base, small, medium, large
WHISPER_USE_GPU=true

# Feature Flags
ALLOW_CLIENT_API_KEYS=true
LOG_SESSIONS=true
LOG_TRANSLATIONS=true

# LLM Provider API Keys
# Uncomment and set the API keys you want to use
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# DEEPSEEK_API_KEY=...
# COHERE_API_KEY=...
# GROQ_API_KEY=...
# GROK_API_KEY=...
# MISTRAL_API_KEY=...
# PERPLEXITY_API_KEY=...

# AI-provider STT currently supports providers with audio transcription endpoints,
# including OpenAI and Groq.

# Local LLM Servers
# OLLAMA_HOST=http://host.docker.internal:11434
# LMSTUDIO_HOST=http://host.docker.internal:1234
